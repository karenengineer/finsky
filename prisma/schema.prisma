generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

enum AdminStatus {
  ACTIVE
  INVITED
  BLOCKED
  DELETED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum ConsultationStatus {
  NEW
  IN_PROGRESS
  COMPLETED
  REJECTED
}

model AdminUser {
  id           String           @id @default(cuid())
  email        String           @unique
  passwordHash String
  firstName    String
  lastName     String
  role         AdminRole
  status       AdminStatus      @default(INVITED)
  lastLoginAt  DateTime?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  sessions     RefreshSession[]

  @@index([role, status])
  @@index([createdAt])
}

model RefreshSession {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  intro           String?
  body            String?
  status          PublishStatus @default(DRAFT)
  sortOrder       Int           @default(0)
  translations    Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sections        PageSection[]
  seoSettings     SeoSettings?

  @@index([status, sortOrder])
}

model PageSection {
  id           String        @id @default(cuid())
  pageId       String
  key          String
  title        String?
  subtitle     String?
  content      Json?
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  translations Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  page         Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, key])
  @@index([status, sortOrder])
}

model Service {
  id               String                @id @default(cuid())
  title            String
  slug             String                @unique
  shortDescription String
  fullDescription  String
  includes         Json?
  icon             String?
  imageUrl         String?
  status           PublishStatus         @default(DRAFT)
  sortOrder        Int                   @default(0)
  translations     Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  requests         ConsultationRequest[]
  seoSettings      SeoSettings?

  @@index([status, sortOrder])
}

model Benefit {
  id           String        @id @default(cuid())
  title        String
  description  String
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  translations Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Statistic {
  id           String        @id @default(cuid())
  value        String
  label        String
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  translations Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, sortOrder])
}

model WorkStep {
  id           String        @id @default(cuid())
  title        String
  description  String
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  translations Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Testimonial {
  id           String        @id @default(cuid())
  authorName   String
  authorRole   String?
  text         String
  isDemo       Boolean       @default(false)
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  translations Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, sortOrder])
}

model FAQ {
  id           String        @id @default(cuid())
  question     String
  answer       String
  status       PublishStatus @default(DRAFT)
  sortOrder    Int           @default(0)
  translations Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, sortOrder])
}

model ContactSettings {
  id           String   @id @default("default")
  phone        String
  email        String
  address      String
  workingHours String
  telegram     String?
  mapUrl       String?
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ConsultationRequest {
  id        String             @id @default(cuid())
  name      String
  phone     String
  email     String
  company   String?
  serviceId String?
  message   String?
  consent   Boolean
  status    ConsultationStatus @default(NEW)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  service   Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([email])
  @@index([phone])
}

model MediaFile {
  id           String   @id @default(cuid())
  originalName String
  fileName     String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model SeoSettings {
  id              String   @id @default(cuid())
  pageSlug        String?
  serviceId       String?  @unique
  metaTitle       String
  metaDescription String
  ogImageUrl      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  page            Page?    @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  service         Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([pageSlug])
  @@index([pageSlug])
}
